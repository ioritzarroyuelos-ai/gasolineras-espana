{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler pages dev dist --binding PUBLIC_ORIGIN=http://127.0.0.1:8787 --port 8787 --show-interactive-dev-session=false",
      "startServerReadyPattern": "Ready on http",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/?municipio=28079",
        "http://127.0.0.1:8787/farmacias/madrid/madrid",
        "http://127.0.0.1:8787/politica/generales",
        "http://127.0.0.1:8787/privacidad"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-gpu --disable-dev-shm-usage",
        "skipAudits": [
          "uses-http2",
          "redirects-http",
          "canonical"
        ],
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 400
          }
        ],
        "speed-index": [
          "error",
          {
            "maxNumericValue": 4500
          }
        ],
        "document-title": "error",
        "meta-description": "error",
        "viewport": "error",
        "html-has-lang": "error",
        "image-alt": "warn",
        "color-contrast": "warn",
        "heading-order": "warn",
        "link-name": "warn",
        "is-on-https": "off",
        "uses-long-cache-ttl": "off",
        "unused-javascript": "off",
        "legacy-javascript": "off",
        "uses-text-compression": "off",
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 250000
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
