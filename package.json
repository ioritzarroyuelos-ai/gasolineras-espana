{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-localidades.mjs && node scripts/gen-client-bundle.mjs && vite",
    "icons": "node scripts/gen-icons.mjs",
    "client": "node scripts/gen-client-bundle.mjs",
    "sw": "node scripts/gen-sw.mjs",
    "prebuild": "node scripts/gen-icons.mjs && node scripts/gen-client-bundle.mjs && node scripts/gen-sw.mjs && node scripts/gen-service-manifest.mjs && node scripts/gen-localidades.mjs",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "node scripts/ship.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lh": "lhci autorun",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "backfill:d1": "node scripts/backfill-d1.mjs",
    "ship": "node scripts/ship.mjs",
    "postinstall": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "node-html-parser": "^9.0.5",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.26.1",
    "@lhci/cli": "^0.16.0",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "@hono/vite-dev-server": {
      "minimatch": "^11.0.1"
    },
    "chrome-launcher": "^1.2.2",
    "glob": "^14.0.3",
    "basic-ftp": "^6.2.1"
  }
}
